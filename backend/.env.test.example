# Copie para .env.test e ajuste usuário e senha do seu Postgres local.
# O nome do banco precisa ter "test": o setup dos testes apaga tudo nele.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/autos_test?schema=public"
JWT_SECRET="segredo_dos_testes"
JWT_EXPIRES_IN="1h"
CORS_ORIGIN="http://localhost:5173"
